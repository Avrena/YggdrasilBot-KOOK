# Production Docker Compose environment template.
# Copy to .env and fill in the required secrets before running `docker compose up -d --build`.

YGG_ENV=prod
TZ=Asia/Shanghai
LOG_LEVEL=INFO
LOG_JSON=true

# Prebuilt image from GitHub Actions GHCR (use `docker compose pull` on 2 GB servers to skip local build).
YGG_IMAGE=ghcr.io/modcrafts/yggdrasil-bot:latest

# Host bind for the dashboard + API port:
# - Behind Caddy/Nginx reverse proxy: 127.0.0.1
# - Private LAN-only direct access (with YGG_AUTH_DISABLED=true): your LAN IP or 0.0.0.0 (firewall port 8080!)
YGG_BIND_HOST=127.0.0.1
YGG_BIND_PORT=8080

# PostgreSQL credentials (used by postgres, migration, bot, worker, scheduler).
POSTGRES_USER=ygg
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=ygg

# REQUIRED: Fernet key encrypting provider API keys and KOOK Bot Token in Postgres.
# Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back this up safely; losing it makes stored API keys unreadable.
YGG_SECRET_KEY=

# Optional bootstrap KOOK Bot Token (or configure live in Dashboard -> 设置 -> KOOK 连接).
# KOOK_BOT_TOKEN=

# REQUIRED: Bootstrap KOOK superuser IDs (JSON string array) and dashboard admin emails.
YGG_SUPERUSERS=["12345678"]
YGG_ADMIN_EMAILS=["admin@example.com"]
# Header set by your reverse proxy / oauth2-proxy / Cloudflare Access after authenticating the admin.
YGG_AUTH_EMAIL_HEADER=X-Auth-Request-Email
# Set true ONLY when the dashboard is reachable strictly on a trusted LAN / VPN (disables dashboard login check).
YGG_AUTH_DISABLED=false

# Optional services (enable with `docker compose --profile render|browser|full up -d --build`).
# YGG_RENDER_URL=http://render:8080
# YGG_BROWSER_URL=http://browser:8080
